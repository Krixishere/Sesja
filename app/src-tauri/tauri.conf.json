{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sesja",
  "version": "1.3.0",
  "identifier": "pl.sesja.reapermultiplayer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sesja",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "backgroundColor": "#0E1424",
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Sesja – REAPER Multiplayer",
    "longDescription": "Sesja instaluje mod REAPER Multiplayer i pozwala nagrywać jeden projekt REAPERa z kilku miejsc naraz: czat, komentarze przy klipach, lista nagrań i kto co dodał.",
    "publisher": "Sesja",
    "copyright": "© 2026 Autorzy projektu Sesja · MIT",
    "homepage": "https://github.com/Krixishere/Sesja",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "currentUser",
        "languages": [
          "Polish",
          "English",
          "German",
          "Spanish",
          "French"
        ],
        "customLanguageFiles": {
          "Polish": "installer/Polish.nsh"
        },
        "displayLanguageSelector": true,
        "startMenuFolder": "Sesja"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
